{
    "layer": "top",
    "position": "top",
    "height": 36,
    "exclusive": true,
    "passthrough": false,
    "spacing": 4,
    "reload_style_on_change": true,

    "modules-left": [
        "niri/workspaces"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "group/stats",
        "group/connectivity",
        "wireplumber",
        "group/shortcuts"
    ],

    // ── Groups ────────────────────────────────────────────────────────────

    "group/stats": {
        "orientation": "horizontal",
        "modules": ["memory", "battery"]
    },

    "group/connectivity": {
        "orientation": "horizontal",
        "modules": ["custom/wifi", "custom/bluetooth", "custom/wlsunset"]
    },

    "group/shortcuts": {
        "orientation": "horizontal",
        "modules": ["image#recordly", "image#discord", "image#figma", "image#protonmail"]
    },

    // ── Workspaces ────────────────────────────────────────────────────────

    "niri/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "●",
            "default": "○",
            "urgent": "◉"
        },
        "on-click": "activate",
        "all-outputs": false
    },

    // ── Clock ─────────────────────────────────────────────────────────────

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%a, %b %d  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "left",
            "on-scroll": 1,
            "format": {
                "months":   "<span color='#ffffff'><b>{}</b></span>",
                "days":     "<span color='#c0caf5'>{}</span>",
                "weeks":    "<span color='#565f89'>W{}</span>",
                "weekdays": "<span color='#7aa2f7'>{}</span>",
                "today":    "<span color='#7dcfff'><b><u>{}</u></b></span>"
            }
        }
    },

    // ── Stats ─────────────────────────────────────────────────────────────

    "memory": {
        "interval": 5,
        "format": "󰍛 {percentage}%",
        "tooltip-format": "{used:0.1f} GB / {total:0.1f} GB used",
        "on-click": "kitty -e btop"
    },

    "battery": {
        "interval": 30,
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-full": "󰁹 full",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "states": {
            "warning": 25,
            "critical": 10
        },
        "tooltip-format": "{timeTo}"
    },

    // ── Volume ────────────────────────────────────────────────────────────

    "wireplumber": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": ["󰕿", "󰖀", "󰕾"],
        "scroll-step": 3,
        "max-volume": 100,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "tooltip-format": "{node_name}"
    },

    // ── Connectivity ──────────────────────────────────────────────────────

    "custom/wifi": {
        "exec": "~/.config/waybar/scripts/wifi.sh",
        "interval": 5,
        "return-type": "json",
        "escape": false,
        "on-click": "kitty -e impala",
        "tooltip": true
    },

    "custom/bluetooth": {
        "exec": "~/.config/waybar/scripts/bluetooth.sh",
        "interval": 5,
        "return-type": "json",
        "on-click": "kitty -e bluetui",
        "tooltip": true
    },

    "custom/wlsunset": {
        "exec": "~/.config/waybar/scripts/wlsunset.sh",
        "interval": 10,
        "return-type": "json",
        "on-click": "~/.config/waybar/scripts/wlsunset-toggle.sh && pkill -RTMIN+8 waybar",
        "signal": 8,
        "tooltip": true
    },

    // ── App launchers (real brand logos, see ./icons) ─────────────────────

    "image#recordly": {
        "exec": "printf '%s\\n%s\\n' ~/.config/waybar/icons/openhunts.png 'Recordly — screen recorder'",
        "interval": "once",
        "size": 12,
        "tooltip": true,
        "on-click": "setsid -f ~/.nix-profile/bin/appimage-run ~/Applications/Recordly.AppImage --no-sandbox >/dev/null 2>&1"
    },
    "image#discord": {
        "exec": "printf '%s\\n%s\\n' ~/.config/waybar/icons/discord.png 'Discord'",
        "interval": "once",
        "size": 12,
        "tooltip": true,
        "on-click": "google-chrome-stable 'https://discord.com/channels/1209144258318303252/1219232004659351622'"
    },
    "image#figma": {
        "exec": "printf '%s\\n%s\\n' ~/.config/waybar/icons/figma.png 'Figma'",
        "interval": "once",
        "size": 12,
        "tooltip": true,
        "on-click": "google-chrome-stable 'https://www.figma.com/files/team/1320674207577627607/recents-and-sharing?fuid=1480537842195332430'"
    },
    "image#protonmail": {
        "exec": "printf '%s\\n%s\\n' ~/.config/waybar/icons/protonmail.png 'Proton Mail'",
        "interval": "once",
        "size": 12,
        "tooltip": true,
        "on-click": "google-chrome-stable 'https://mail.proton.me/u/5/inbox'"
    }
}
